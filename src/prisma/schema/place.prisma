model PlaceLocation {
    id               BigInt       @id @default(autoincrement())
    placeId          BigInt
    type             Int // EnumPlaceLocationType
    supportedVehicle Int[]        @default([0]) // EnumVehicleType
    latitude         Decimal      @db.Decimal(10, 7)
    longitude        Decimal      @db.Decimal(10, 7)
    isDeleted        Boolean      @default(false)
    placeProfile     PlaceProfile @relation(fields: [placeId], references: [id])
    createdAt        DateTime     @default(now())
    updatedAt        DateTime     @default(now()) @updatedAt

    @@index([placeId])
    @@index([type])
    @@index([isDeleted])
    @@index([type, isDeleted])
    @@index([latitude, longitude])
    @@map("place_location")
}

model PlaceProfile {
    id          BigInt          @id @default(autoincrement())
    cityId      Int
    title       String
    isDeleted   Boolean         @default(false)
    description String?
    coverImage  String?
    logo        String?
    phone       String?
    mobile      String?
    website     String?
    email       String?
    address     String?
    city        City            @relation(fields: [cityId], references: [id])
    locations   PlaceLocation[]
    createdAt   DateTime        @default(now())
    updatedAt   DateTime        @default(now()) @updatedAt

    @@map("place_profile")
}
