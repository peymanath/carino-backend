model Passkey {
    id           String          @id @default(uuid()) @db.Uuid
    name         String?
    credentialId String          @unique
    publicKey    Bytes
    counter      BigInt          @default(0)
    transports   String[]
    deviceType   Int             @default(0)
    backedUp     Int             @default(0)
    isDeleted    Boolean         @default(false)
    createdAt    DateTime        @default(now())
    updatedAt    DateTime        @default(now()) @updatedAt
    userId       Int
    user         User            @relation(fields: [userId], references: [id])
    providerId   Int
    provider     PasskeyProvider @relation(fields: [providerId], references: [id])

    @@index([userId])
    @@map("user_passkey")
}

model PasskeyProvider {
    id           Int       @id @default(autoincrement())
    aaguid       String    @unique
    name         String
    providerType Int       @default(0)
    passkeys     Passkey[]

    @@map("user_passkey_provider")
}
