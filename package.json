{
  "name": "carino",
  "private": true,
  "scripts": {
    "dev": "nest start --watch",
    "dev:local": "env-cmd -f .env.local  nest start --watch",
    "dev:dev": "env-cmd -f .env.development  nest start --watch",
    "dev:prod": "env-cmd -f .env.production  nest start --watch",
    "build": "nest build",
    "vercel-build": "prisma generate && prisma migrate deploy",
    "start": "nest start",
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "check-types": "turbo run check-types",
    "prisma:generate": "prisma generate",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:create": "prisma migrate --create-only",
    "database:dev": "prisma migrate reset && prisma generate && prisma migrate dev",
    "key:base64": "bash -lc \"sed -i -E '/^JWT_PRIVATE_B64=/d; /^JWT_PUBLIC_B64=/d' key/base64.txt && printf 'JWT_PRIVATE_B64=%s\\nJWT_PUBLIC_B64=%s\\n' \\\"$(base64 -w 0 key/private.pem)\\\" \\\"$(base64 -w 0 key/public.pem)\\\" >> key/base64.txt\"",
    "clean": " find . -type d \\( -name dist -o -name .next -o -name .turbo -o -name node_modules -o -name .svelte-kit \\) -prune -exec rm -rf '{}' + && find . -name pnpm-lock.yaml -exec rm -f '{}' +",
    "prepare": "husky"
  },
  "prisma": {
    "schema": "./src/prisma"
  },
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mapped-types": "*",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.0.3",
    "@prisma/client": "^6.14.0",
    "@simplewebauthn/server": "^13.2.2",
    "axios": "^1.13.2",
    "axios-cookiejar-support": "^6.0.4",
    "bcryptjs": "^3.0.0",
    "bullmq": "^5.63.0",
    "cheerio": "^1.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "env-cmd": "^11.0.0",
    "husky": "^9.1.7",
    "ioredis": "^5.8.2",
    "minio": "^8.0.6",
    "node-fetch": "^3.3.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "svg-captcha": "^1.4.0",
    "svgo": "^4.0.0",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "tough-cookie": "^6.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^16.0.0",
    "prettier": "^3.4.2",
    "prisma": "^6.14.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.3",
    "typescript": "^5.7.3"
  }
}